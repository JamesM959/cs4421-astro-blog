---
interface Props {
	date?: Date;
}

const { date } = Astro.props;
const hasValidDate = date instanceof Date && !Number.isNaN(date.getTime());
---

{hasValidDate && (
	<time datetime={date.toISOString()}>
		{
			date.toLocaleDateString('en-us', {
				year: 'numeric',
				month: 'short',
				day: 'numeric',
			})
		}
	</time>
)}
