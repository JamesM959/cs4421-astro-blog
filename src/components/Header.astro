---
import { SITE_TITLE } from '../styles/consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links" id="primary-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/portfolio">Portfolio</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/watchlist">Watchlist</HeaderLink>
		</div>
		<button
			class="nav-toggle"
			type="button"
			aria-label="Minimize navigation"
			aria-expanded="true"
			aria-controls="primary-links"
			title="Minimize navigation"
		>
			<span aria-hidden="true">-</span>
		</button>
	</nav>
</header>
<script>
	const header = document.querySelector('header');
	const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');

	if (header && toggle) {
		const storageKey = 'site-nav-minimized';
		const setMinimized = (minimized: boolean) => {
			header.classList.toggle('nav-minimized', minimized);
			toggle.setAttribute('aria-expanded', String(!minimized));
			toggle.setAttribute('aria-label', minimized ? 'Expand navigation' : 'Minimize navigation');
			toggle.title = minimized ? 'Expand navigation' : 'Minimize navigation';
			toggle.textContent = minimized ? '+' : '-';
		};

		setMinimized(localStorage.getItem(storageKey) === 'true');
		toggle.addEventListener('click', () => {
			const minimized = toggle.getAttribute('aria-expanded') === 'true';
			setMinimized(minimized);
			localStorage.setItem(storageKey, String(minimized));
		});
	}
</script>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.nav-minimized .internal-links {
		display: none;
	}
	.nav-toggle {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--black);
		font-size: 1.25rem;
		cursor: pointer;
	}
	.nav-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
</style>
