---
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="About Me"
	description="Learn about this blog and search public companies by name or ticker."
	pubDate={new Date('August 08 2021')}
>

	<section class="company-search" aria-labelledby="company-search-title">
		<p class="eyebrow">Market directory</p>
		<h2 id="company-search-title">Search public companies</h2>
		<p class="search-description">Look up a company by name or ticker symbol. Results are provided by Yahoo Finance.</p>
		<form id="company-search-form" role="search">
			<label for="company-search-query">Company name or ticker</label>
			<div class="search-controls">
				<input id="company-search-query" name="q" type="search" maxlength="80" placeholder="Try Apple or AAPL" autocomplete="off" required />
				<button type="submit">Search</button>
			</div>
		</form>
		<p id="company-search-status" class="search-status" role="status" aria-live="polite">Enter a company name or ticker to begin.</p>
		<ul id="company-search-results" class="search-results" aria-label="Company search results" hidden></ul>
		<section id="performance-panel" class="performance-panel" aria-labelledby="performance-title" hidden>
			<div class="performance-heading">
				<div>
					<p id="range-title" class="eyebrow">Past year</p>
					<div class="performance-title-row">
						<h3 id="performance-title"></h3>
						<button id="portfolio-add" class="portfolio-add" type="button">Add to portfolio</button>
						<button
							id="watchlist-toggle"
							class="watchlist-toggle"
							type="button"
							aria-pressed="false"
							aria-label="Add company to watchlist"
							title="Add company to watchlist">+</button
						>
					</div>
				</div>
				<p id="period-change" class="period-change"></p>
			</div>
			<p id="portfolio-action-status" class="search-status" role="status" aria-live="polite" hidden></p>
			<p id="watchlist-action-status" class="search-status" role="status" aria-live="polite" hidden></p>
			<p id="chart-status" class="search-status" role="status" aria-live="polite"></p>
			<svg id="stock-chart" class="stock-chart" viewBox="0 0 760 340" role="img" aria-hidden="true"></svg>
			<div class="range-controls" role="group" aria-label="Stock chart time range">
				<button type="button" data-range="5d" aria-pressed="false">Week</button>
				<button type="button" data-range="1mo" aria-pressed="false">Month</button>
				<button type="button" data-range="1y" aria-pressed="true">Year</button>
				<button type="button" data-range="5y" aria-pressed="false">5 years</button>
				<button type="button" data-range="max" aria-pressed="false">Past performance</button>
			</div>
			<p class="chart-footnote">Historical share prices are not a guarantee of future performance.</p>
		</section>
	</section>
	<dialog id="portfolio-allocation-dialog" class="allocation-dialog" aria-labelledby="portfolio-allocation-title">
		<form id="portfolio-allocation-form">
			<h2 id="portfolio-allocation-title">Set portfolio allocation</h2>
			<p id="portfolio-allocation-help"></p>
			<label for="portfolio-allocation-input">Allocation percentage</label>
			<div class="allocation-controls">
				<input id="portfolio-allocation-input" type="number" min="0.01" max="99.99" step="0.01" required />
				<span aria-hidden="true">%</span>
			</div>
			<div class="allocation-actions">
				<button type="submit">Add holding</button>
				<button id="portfolio-allocation-cancel" type="button">Cancel</button>
			</div>
		</form>
	</dialog>
</Layout>

<style>
	:global(.title) {
		display: none;
	}
</style>

<script>
	import {
		getWatchlist,
		removeWatchlistEntry,
		saveWatchlistEntry,
		updateWatchlistPrice,
		WATCHLIST_STORAGE_KEY,
	} from '../lib/watchlist';
	import {
		addPortfolioEntry,
		getPortfolio,
		PORTFOLIO_STORAGE_KEY,
	} from '../lib/portfolio';
	import {
		fetchStockHistory,
		renderStockChart,
		STOCK_RANGE_LABELS,
		type StockHistory,
		type StockHistoryRange,
	} from '../lib/stock-chart';

	interface CompanyResult {
		symbol: string;
		name: string;
		exchange: string;
	}
	type HistoryRange = StockHistoryRange;
	const rangeLabels = STOCK_RANGE_LABELS;

	const form = document.querySelector<HTMLFormElement>('#company-search-form');
	const queryField = document.querySelector<HTMLInputElement>('#company-search-query');
	const status = document.querySelector<HTMLElement>('#company-search-status');
	const results = document.querySelector<HTMLUListElement>('#company-search-results');
	const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
	const performancePanel = document.querySelector<HTMLElement>('#performance-panel');
	const performanceTitle = document.querySelector<HTMLElement>('#performance-title');
	const watchlistButton = document.querySelector<HTMLButtonElement>('#watchlist-toggle');
	const watchlistActionStatus = document.querySelector<HTMLElement>('#watchlist-action-status');
	const portfolioButton = document.querySelector<HTMLButtonElement>('#portfolio-add');
	const portfolioActionStatus = document.querySelector<HTMLElement>('#portfolio-action-status');
	const allocationDialog = document.querySelector<HTMLDialogElement>('#portfolio-allocation-dialog');
	const allocationForm = document.querySelector<HTMLFormElement>('#portfolio-allocation-form');
	const allocationInput = document.querySelector<HTMLInputElement>('#portfolio-allocation-input');
	const allocationHelp = document.querySelector<HTMLElement>('#portfolio-allocation-help');
	const allocationCancel = document.querySelector<HTMLButtonElement>('#portfolio-allocation-cancel');
	const rangeTitle = document.querySelector<HTMLElement>('#range-title');
	const periodChange = document.querySelector<HTMLElement>('#period-change');
	const chartStatus = document.querySelector<HTMLElement>('#chart-status');
	const stockChart = document.querySelector<SVGSVGElement>('#stock-chart');
	const rangeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.range-controls [data-range]'));
	let chartRequest: AbortController | undefined;
	let selectedCompany: CompanyResult | undefined;
	let latestHistory: StockHistory | undefined;

	const updatePortfolioButton = (company: CompanyResult) => {
		if (!portfolioButton) return;
		const hasPrice = latestHistory?.prices.at(-1) !== undefined;
		const inPortfolio = getPortfolio().some(
			(entry) => entry.symbol.toUpperCase() === company.symbol.toUpperCase(),
		);
		portfolioButton.disabled = inPortfolio || !hasPrice;
		portfolioButton.textContent = inPortfolio
			? 'In portfolio'
			: hasPrice
				? 'Add to portfolio'
				: 'Price unavailable';
	};

	const savePortfolioHolding = (allocation?: number) => {
		if (!selectedCompany || !portfolioActionStatus) return;
		const latestPrice = latestHistory?.prices.at(-1);
		if (!latestPrice || !latestHistory) {
			throw new Error('A stock price is not available yet. Try again when price history has loaded.');
		}
		addPortfolioEntry({
			symbol: selectedCompany.symbol,
			name: selectedCompany.name,
			exchange: selectedCompany.exchange,
			price: latestPrice.close,
			currency: latestHistory.currency,
			priceDate: latestPrice.date,
		}, allocation);
		portfolioActionStatus.hidden = false;
		portfolioActionStatus.textContent = `${selectedCompany.symbol} added to your portfolio.`;
		updatePortfolioButton(selectedCompany);
	};

	portfolioButton?.addEventListener('click', () => {
		if (!selectedCompany || !portfolioActionStatus) return;
		try {
			const entries = getPortfolio();
			if (entries.length === 0) {
				savePortfolioHolding();
				return;
			}
			if (!allocationDialog || !allocationInput || !allocationHelp) {
				throw new Error('The portfolio allocation form is unavailable.');
			}
			allocationInput.value = '10';
			allocationHelp.textContent =
				'Choose this stock’s percentage. Existing holdings will be proportionally adjusted so the portfolio totals 100%.';
			allocationDialog.showModal();
			allocationInput.focus();
		} catch (error) {
			portfolioActionStatus.hidden = false;
			portfolioActionStatus.textContent =
				error instanceof Error ? error.message : 'Unable to update your portfolio.';
		}
	});

	allocationForm?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!allocationInput || !portfolioActionStatus) return;
		const allocation = Number(allocationInput.value);
		if (!Number.isFinite(allocation) || allocation <= 0 || allocation >= 100) {
			portfolioActionStatus.hidden = false;
			portfolioActionStatus.textContent = 'Choose a percentage greater than 0% and less than 100%.';
			return;
		}
		try {
			savePortfolioHolding(allocation);
			allocationDialog?.close();
		} catch (error) {
			portfolioActionStatus.hidden = false;
			portfolioActionStatus.textContent =
				error instanceof Error ? error.message : 'Unable to update your portfolio.';
		}
	});
	allocationCancel?.addEventListener('click', () => allocationDialog?.close());

	const updateWatchlistButton = (company: CompanyResult) => {
		if (!watchlistButton) return;
		const inWatchlist = getWatchlist().some(
			(entry) => entry.symbol.toUpperCase() === company.symbol.toUpperCase(),
		);
		watchlistButton.textContent = inWatchlist ? '-' : '+';
		watchlistButton.setAttribute('aria-pressed', String(inWatchlist));
		watchlistButton.setAttribute(
			'aria-label',
			`${inWatchlist ? 'Remove' : 'Add'} ${company.name} (${company.symbol}) ${inWatchlist ? 'from' : 'to'} watchlist`,
		);
		watchlistButton.title = inWatchlist ? 'Remove from watchlist' : 'Add to watchlist';
	};

	watchlistButton?.addEventListener('click', () => {
		if (!selectedCompany || !watchlistActionStatus) return;
		watchlistActionStatus.hidden = false;
		try {
			const isSaved = getWatchlist().some(
				(entry) => entry.symbol.toUpperCase() === selectedCompany?.symbol.toUpperCase(),
			);
			if (isSaved) {
				removeWatchlistEntry(selectedCompany.symbol);
				watchlistActionStatus.textContent = `${selectedCompany.symbol} removed from your watchlist.`;
			} else {
				const latestPrice = latestHistory?.prices.at(-1);
				saveWatchlistEntry({
					symbol: selectedCompany.symbol,
					name: selectedCompany.name,
					exchange: selectedCompany.exchange,
					...(latestPrice && latestHistory
						? {
								price: latestPrice.close,
								currency: latestHistory.currency,
								priceDate: latestPrice.date,
							}
						: {}),
				});
				watchlistActionStatus.textContent = `${selectedCompany.symbol} added to your watchlist.`;
			}
			updateWatchlistButton(selectedCompany);
		} catch (error) {
			watchlistActionStatus.textContent =
				error instanceof Error ? error.message : 'Unable to update your watchlist.';
		}
	});

	window.addEventListener('storage', (event) => {
		if (!selectedCompany) return;
		try {
			if (event.key === WATCHLIST_STORAGE_KEY) updateWatchlistButton(selectedCompany);
			if (event.key === PORTFOLIO_STORAGE_KEY) updatePortfolioButton(selectedCompany);
		} catch (error) {
			if (event.key === PORTFOLIO_STORAGE_KEY && portfolioActionStatus) {
				portfolioActionStatus.hidden = false;
				portfolioActionStatus.textContent =
					error instanceof Error ? error.message : 'Unable to read your portfolio.';
			} else if (watchlistActionStatus) {
				watchlistActionStatus.hidden = false;
				watchlistActionStatus.textContent =
					error instanceof Error ? error.message : 'Unable to read your watchlist.';
			}
		}
	});

	const showCompanyHistory = async (company: CompanyResult, range: HistoryRange = '1y') => {
		if (!performancePanel || !performanceTitle || !rangeTitle || !chartStatus || !stockChart || !periodChange) return;
		chartRequest?.abort();
		const request = new AbortController();
		chartRequest = request;
		performancePanel.hidden = false;
		performanceTitle.textContent = `${company.name} (${company.symbol})`;
		if (selectedCompany?.symbol.toUpperCase() === company.symbol.toUpperCase()) {
			try {
				updateWatchlistButton(company);
				updatePortfolioButton(company);
			} catch (error) {
				if (watchlistActionStatus) {
					watchlistActionStatus.hidden = false;
					watchlistActionStatus.textContent =
						error instanceof Error ? error.message : 'Unable to read your watchlist.';
				}
			}
		}
		rangeTitle.textContent = rangeLabels[range];
		chartStatus.textContent = '';
		if (periodChange) periodChange.textContent = '';

		try {
			const history = await fetchStockHistory(company.symbol, range, request.signal);
			renderStockChart(stockChart, periodChange, history, range);
			if (selectedCompany?.symbol.toUpperCase() === company.symbol.toUpperCase()) {
				latestHistory = history;
				try {
					updatePortfolioButton(company);
				} catch (error) {
					if (portfolioActionStatus) {
						portfolioActionStatus.hidden = false;
						portfolioActionStatus.textContent =
							error instanceof Error ? error.message : 'Unable to read your portfolio.';
					}
				}
				const latestPrice = history.prices.at(-1);
				if (latestPrice) {
					try {
						updateWatchlistPrice(
							company.symbol,
							latestPrice.close,
							history.currency,
							latestPrice.date,
						);
					} catch (error) {
						if (watchlistActionStatus) {
							watchlistActionStatus.hidden = false;
							watchlistActionStatus.textContent =
								error instanceof Error ? error.message : 'Unable to update the saved watchlist price.';
						}
					}
				}
			}
			chartStatus.textContent = '';
		} catch (error) {
			if (error instanceof DOMException && error.name === 'AbortError') return;
			chartStatus.textContent = error instanceof Error ? error.message : 'Price history could not be reached.';
		} finally {
			if (chartRequest === request) chartRequest = undefined;
		}
	};

	for (const button of rangeButtons) {
		button.addEventListener('click', () => {
			if (!selectedCompany) return;
			const range = button.dataset.range as HistoryRange;
			for (const rangeButton of rangeButtons) {
				rangeButton.setAttribute('aria-pressed', String(rangeButton === button));
			}
			showCompanyHistory(selectedCompany, range);
		});
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const query = queryField?.value.trim();
		if (!query || !status || !results || !submitButton) return;

		results.replaceChildren();
		results.hidden = true;
		performancePanel?.setAttribute('hidden', '');
		chartRequest?.abort();
		status.textContent = 'Searching companies…';
		submitButton.disabled = true;

		try {
			const response = await fetch(`/api/finance/search?q=${encodeURIComponent(query)}`);
			const payload: unknown = await response.json();
			if (!response.ok) {
				const message = typeof payload === 'object' && payload !== null && 'error' in payload
					&& typeof payload.error === 'string'
					? payload.error
					: 'Company search is temporarily unavailable.';
				throw new Error(message);
			}
			if (!Array.isArray(payload)) throw new Error('Unexpected response from company search.');

			const companies = payload as CompanyResult[];
			if (companies.length === 0) {
				status.textContent = 'No listed companies found. Try another name or ticker.';
				return;
			}

			for (const company of companies) {
				const item = document.createElement('li');
				item.className = 'search-result';
				const option = document.createElement('button');
				option.type = 'button';
				option.className = 'company-option';
				option.setAttribute('aria-label', `View stock performance for ${company.name} (${company.symbol})`);
				const identity = document.createElement('div');
				identity.className = 'company-identity';
				const symbol = document.createElement('strong');
				symbol.className = 'company-symbol';
				symbol.textContent = company.symbol;
				const name = document.createElement('span');
				name.className = 'company-name';
				name.textContent = company.name;
				identity.append(symbol, name);
				option.append(identity);
				if (company.exchange) {
					const exchange = document.createElement('span');
					exchange.className = 'company-exchange';
					exchange.textContent = company.exchange;
					option.append(exchange);
				}
				option.addEventListener('click', () => {
					selectedCompany = company;
					latestHistory = undefined;
					results.hidden = true;
					results.replaceChildren();
					status.textContent = `Selected ${company.name} (${company.symbol}).`;
					if (watchlistActionStatus) {
						watchlistActionStatus.hidden = true;
						watchlistActionStatus.textContent = '';
					}
					if (portfolioActionStatus) {
						portfolioActionStatus.hidden = true;
						portfolioActionStatus.textContent = '';
					}
					try {
						updatePortfolioButton(company);
					} catch (error) {
						if (portfolioActionStatus) {
							portfolioActionStatus.hidden = false;
							portfolioActionStatus.textContent =
								error instanceof Error ? error.message : 'Unable to read your portfolio.';
						}
					}
					for (const rangeButton of rangeButtons) {
						rangeButton.setAttribute('aria-pressed', String(rangeButton.dataset.range === '1y'));
					}
					showCompanyHistory(company, '1y');
				});
				item.append(option);
				results.append(item);
			}

			results.hidden = false;
				selectedCompany = undefined;
			status.textContent = `${companies.length} ${companies.length === 1 ? 'company' : 'companies'} found.`;
		} catch (error) {
			status.textContent = error instanceof Error ? error.message : 'Company search could not be reached.';
		} finally {
			submitButton.disabled = false;
		}
	});

	selectedCompany = { symbol: 'AAPL', name: 'Apple Inc.', exchange: 'NASDAQ' };
	try {
		updatePortfolioButton(selectedCompany);
	} catch (error) {
		if (portfolioActionStatus) {
			portfolioActionStatus.hidden = false;
			portfolioActionStatus.textContent =
				error instanceof Error ? error.message : 'Unable to read your portfolio.';
		}
	}
	showCompanyHistory(selectedCompany, '1y');
</script>

<style>
	.company-search {
		margin: 0 0 2.5rem;
	}
	.eyebrow {
		margin: 0 0 0.4rem;
		color: #26735e;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.company-search h2 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.8rem;
		font-weight: 400;
	}
	.search-description {
		margin: 0.5rem 0 1.25rem;
		color: #68736e;
		font-size: 0.9rem;
	}
	#company-search-form label {
		display: block;
		margin-bottom: 0.4rem;
		font-size: 0.85rem;
		font-weight: 700;
	}
	.search-controls {
		display: flex;
		gap: 0.6rem;
	}
	.search-controls input {
		width: 100%;
		min-width: 0;
		min-height: 48px;
		border: 1px solid #cbd3cd;
		border-radius: 3px;
		padding: 0.65rem 0.75rem;
		font: inherit;
		font-size: 1rem;
	}
	.search-controls input:focus-visible {
		outline: 2px solid #26735e;
		outline-offset: 2px;
	}
	.search-controls button {
		flex: 0 0 auto;
		min-height: 48px;
		border: 0;
		border-radius: 3px;
		background: #174e40;
		padding: 0.65rem 1rem;
		color: #fff;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 700;
		cursor: pointer;
	}
	.search-controls button:hover:not(:disabled) {
		background: #26735e;
	}
	.search-controls button:disabled {
		cursor: wait;
		opacity: 0.65;
	}
	.search-controls button:focus-visible {
		outline: 3px solid #95c7ae;
		outline-offset: 3px;
	}
	.search-status {
		margin: 1rem 0 0;
		color: #68736e;
		font-size: 0.85rem;
	}
	.search-results {
		margin: 0.75rem 0 0;
		padding: 0;
		border-top: 1px solid rgb(var(--gray-light));
		list-style: none;
	}
	:global(.search-result) {
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	:global(.company-option) {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border: 0;
		background: transparent;
		padding: 0.8rem 0;
		color: inherit;
		text-align: left;
		font: inherit;
		cursor: pointer;
	}
	:global(.company-option:hover) {
		background: #f3f7f4;
	}
	:global(.company-option:focus-visible) {
		outline: 2px solid #26735e;
		outline-offset: -2px;
	}
	:global(.company-identity) {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
	}
	:global(.company-symbol) {
		color: #174e40;
		font-size: 0.95rem;
	}
	:global(.company-name),
	:global(.company-exchange) {
		color: #68736e;
		font-size: 0.8rem;
	}
	:global(.company-name) {
		overflow-wrap: anywhere;
	}
	:global(.company-exchange) {
		flex: 0 0 auto;
		text-align: right;
	}
	.performance-panel {
		margin-top: 2rem;
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1.5rem;
	}
	.performance-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
	}
	.performance-heading .eyebrow {
		margin-bottom: 0.35rem;
	}
	.performance-heading h3 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.5rem;
		font-weight: 400;
	}
	.performance-title-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.watchlist-toggle {
		display: grid;
		width: 36px;
		height: 36px;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid #174e40;
		border-radius: 50%;
		background: #fff;
		color: #174e40;
		font: inherit;
		font-size: 1.3rem;
		line-height: 1;
		cursor: pointer;
	}
	.watchlist-toggle[aria-pressed='true'] {
		background: #174e40;
		color: #fff;
	}
	.watchlist-toggle:focus-visible {
		outline: 3px solid #95c7ae;
		outline-offset: 2px;
	}
	.portfolio-add,
	.allocation-actions button {
		min-height: 40px;
		border: 1px solid #174e40;
		border-radius: 3px;
		background: #174e40;
		padding: 0.45rem 0.75rem;
		color: #fff;
		font: inherit;
		font-size: 0.85rem;
		font-weight: 700;
		cursor: pointer;
	}
	.portfolio-add:disabled {
		background: #68736e;
		border-color: #68736e;
		cursor: default;
	}
	.portfolio-add:focus-visible,
	.allocation-actions button:focus-visible {
		outline: 3px solid #95c7ae;
		outline-offset: 2px;
	}
	.allocation-dialog {
		width: min(100% - 2rem, 28rem);
		border: 1px solid #cbd3cd;
		border-radius: 6px;
		padding: 1.5rem;
		color: inherit;
	}
	.allocation-dialog::backdrop {
		background: rgb(0 0 0 / 45%);
	}
	.allocation-dialog h2 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.4rem;
		font-weight: 400;
	}
	.allocation-dialog p {
		color: #68736e;
		font-size: 0.9rem;
	}
	.allocation-dialog label {
		display: block;
		margin-bottom: 0.35rem;
		font-size: 0.85rem;
		font-weight: 700;
	}
	.allocation-controls {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.allocation-controls input {
