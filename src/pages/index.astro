---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const initialAmount = 100;
const initialRate = 8;
const initialYears = 40;
const chartWidth = 760;
const chartHeight = 320;
const chartPadding = { top: 20, right: 20, bottom: 40, left: 76 };
const initialValues = Array.from({ length: initialYears + 1 }, (_, year) =>
	initialAmount * (1 + initialRate / 100) ** year,
);
const initialMax = initialValues[initialValues.length - 1] * 1.08;
const plotWidth = chartWidth - chartPadding.left - chartPadding.right;
const plotHeight = chartHeight - chartPadding.top - chartPadding.bottom;
const initialPath = initialValues
	.map((value, year) => {
		const x = chartPadding.left + (year / initialYears) * plotWidth;
		const y = chartPadding.top + (1 - value / initialMax) * plotHeight;
		return `${year === 0 ? 'M' : 'L'} ${x.toFixed(2)} ${y.toFixed(2)}`;
	})
	.join(' ');
const initialFinalValue = initialValues[initialValues.length - 1];
const formatEuro = (value: number) =>
	new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(value);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="page-title">
				<p class="eyebrow">A little perspective, compounded</p>
				<h1 id="page-title">Let time do<br />the heavy lifting.</h1>
				<p class="intro-copy">See how a starting investment could grow, then make the numbers your own.</p>
			</section>

			<section class="growth" aria-labelledby="growth-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">The long view</p>
						<h2 id="growth-title">Small start. Long runway.</h2>
					</div>
					<p class="assumption">Annual growth compounded monthly · deposits at month-end</p>
				</div>

				<div class="result-row" aria-live="polite">
					<div>
						<span class="result-label">Estimated value after <span id="summary-years">40</span> years</span>
						<strong id="final-value">{formatEuro(initialFinalValue)}</strong>
					</div>
					<p class="result-note"><span id="summary-principal">€100</span> invested at <span id="summary-rate">8%</span> a year <span id="summary-monthly">with no monthly additions</span></p>
				</div>

				<div class="chart-wrap">
					<svg id="growth-chart" viewBox={`0 0 ${chartWidth} ${chartHeight}`} role="img" aria-label="Investment growth chart showing 100 euros growing at 8 percent annually for 40 years">
						<g class="chart-grid" aria-hidden="true">
							{Array.from({ length: 5 }, (_, index) => {
								const fraction = index / 4;
								const y = chartPadding.top + fraction * plotHeight;
								return <line x1={chartPadding.left} y1={y} x2={chartWidth - chartPadding.right} y2={y} />;
							})}
						</g>
						<g id="y-labels" class="chart-labels" aria-hidden="true">
							{Array.from({ length: 5 }, (_, index) => {
								const fraction = 1 - index / 4;
								const y = chartPadding.top + (index / 4) * plotHeight;
								return <text x={chartPadding.left - 12} y={y + 4} text-anchor="end">{formatEuro(initialMax * fraction)}</text>;
							})}
						</g>
						<path id="chart-area" class="chart-area" d={`${initialPath} L ${chartWidth - chartPadding.right} ${chartHeight - chartPadding.bottom} L ${chartPadding.left} ${chartHeight - chartPadding.bottom} Z`} />
						<path id="chart-line" class="chart-line" d={initialPath} />
						<g id="x-labels" class="chart-labels" aria-hidden="true">
							{[0, 10, 20, 30, 40].map((year) => {
								const x = chartPadding.left + (year / initialYears) * plotWidth;
								return <text x={x} y={chartHeight - 10} text-anchor="middle">Year {year}</text>;
							})}
						</g>
					</svg>
				</div>
			</section>

			<section class="calculator" aria-labelledby="calculator-title">
				<div class="calculator-copy">
					<p class="eyebrow">Your turn</p>
					<h2 id="calculator-title">Try your own numbers.</h2>
					<p>Adjust the starting amount, yearly growth rate and time horizon.</p>
				</div>
				<form id="calculator-form">
					<label>
						<span>Starting amount</span>
						<span class="input-wrap"><span aria-hidden="true">€</span><input name="amount" type="number" min="1" max="10000000" step="1" value="100" required /></span>
					</label>
					<label>
						<span>Yearly growth</span>
						<span class="input-wrap"><input name="rate" type="number" min="0" max="100" step="0.1" value="8" required /><span aria-hidden="true">%</span></span>
					</label>
					<label>
						<span>Monthly contribution</span>
						<span class="input-wrap"><span aria-hidden="true">€</span><input name="monthly" type="number" min="0" max="1000000" step="1" value="0" required /></span>
					</label>
					<label>
						<span>Years invested</span>
						<span class="input-wrap"><input name="years" type="number" min="1" max="100" step="1" value="40" required /><span class="unit">years</span></span>
					</label>
					<button type="submit">Calculate growth <span aria-hidden="true">↗</span></button>
					<p class="form-error" id="form-error" role="alert" hidden>Enter a valid starting amount, growth rate, monthly contribution and number of years.</p>
				</form>
			</section>
			<p class="disclaimer">Illustration only. Real investment returns vary and are not guaranteed. This estimate does not include fees, taxes or inflation.</p>
		</main>
		<Footer />
	</body>
</html>

<script>
	const form = document.querySelector<HTMLFormElement>('#calculator-form');
	const chart = document.querySelector<SVGSVGElement>('#growth-chart');
	const finalValue = document.querySelector<HTMLElement>('#final-value');
	const errorMessage = document.querySelector<HTMLElement>('#form-error');
	const numberFormat = new Intl.NumberFormat('en-IE', {
		style: 'currency',
		currency: 'EUR',
		maximumFractionDigits: 0,
	});

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		const values = new FormData(form);
		const amount = Number(values.get('amount'));
		const rate = Number(values.get('rate'));
		const monthly = Number(values.get('monthly'));
		const years = Number(values.get('years'));
		const valid = Number.isFinite(amount) && amount >= 1 && amount <= 10_000_000
			&& Number.isFinite(rate) && rate >= 0 && rate <= 100
			&& Number.isFinite(monthly) && monthly >= 0 && monthly <= 1_000_000
			&& Number.isInteger(years) && years >= 1 && years <= 100;

		if (!valid || !chart || !finalValue) {
			if (errorMessage) errorMessage.hidden = false;
			return;
		}
		if (errorMessage) errorMessage.hidden = true;

		const width = 760;
		const height = 320;
		const padding = { top: 20, right: 20, bottom: 40, left: 76 };
		const plotWidth = width - padding.left - padding.right;
		const plotHeight = height - padding.top - padding.bottom;
		const monthlyRate = (1 + rate / 100) ** (1 / 12) - 1;
		const data = [amount];
		let balance = amount;
		for (let year = 1; year <= years; year += 1) {
			for (let month = 0; month < 12; month += 1) {
				balance = balance * (1 + monthlyRate) + monthly;
			}
			data.push(balance);
		}
		const maxValue = data[data.length - 1] > 0 ? data[data.length - 1] * 1.08 : amount;
		const path = data.map((value, year) => {
			const x = padding.left + (year / years) * plotWidth;
			const y = padding.top + (1 - value / maxValue) * plotHeight;
			return `${year === 0 ? 'M' : 'L'} ${x.toFixed(2)} ${y.toFixed(2)}`;
		}).join(' ');
		const areaPath = `${path} L ${width - padding.right} ${height - padding.bottom} L ${padding.left} ${height - padding.bottom} Z`;
		const yLabels = Array.from({ length: 5 }, (_, index) => {
			const fraction = 1 - index / 4;
			const y = padding.top + (index / 4) * plotHeight;
			return `<text x="${padding.left - 12}" y="${y + 4}" text-anchor="end">${numberFormat.format(maxValue * fraction)}</text>`;
		}).join('');
		const xLabels = [0, 0.25, 0.5, 0.75, 1].map((fraction) => {
			const year = Math.round(years * fraction);
			const x = padding.left + fraction * plotWidth;
			return `<text x="${x}" y="${height - 10}" text-anchor="middle">Year ${year}</text>`;
		}).join('');
		const grid = Array.from({ length: 5 }, (_, index) => {
			const y = padding.top + (index / 4) * plotHeight;
			return `<line x1="${padding.left}" y1="${y}" x2="${width - padding.right}" y2="${y}" />`;
		}).join('');

		chart.innerHTML = `<g class="chart-grid" aria-hidden="true">${grid}</g><g class="chart-labels" aria-hidden="true">${yLabels}</g><path class="chart-area" d="${areaPath}" /><path class="chart-line" d="${path}" /><g class="chart-labels" aria-hidden="true">${xLabels}</g>`;
		chart.setAttribute('aria-label', `Investment growth chart showing ${numberFormat.format(amount)} initially, with ${numberFormat.format(monthly)} added monthly, growing at ${rate} percent annually for ${years} years`);
		finalValue.textContent = numberFormat.format(data[data.length - 1]);
		document.querySelector('#summary-years')!.textContent = String(years);
		document.querySelector('#summary-principal')!.textContent = numberFormat.format(amount);
		document.querySelector('#summary-rate')!.textContent = `${rate}%`;
		document.querySelector('#summary-monthly')!.textContent = monthly > 0
			? `plus ${numberFormat.format(monthly)}/month`
			: 'with no monthly additions';
		chart.scrollIntoView({
			behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
			block: 'center',
		});
	});
</script>

<style>
	main {
		width: 100%;
		max-width: 1160px;
		padding: 4.5rem 2rem 3rem;
	}
	.intro {
		padding: 2rem 0 4rem;
		max-width: 700px;
	}
	.eyebrow {
		margin: 0 0 1rem;
		color: #26735e;
		font-family: var(--font-atkinson);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.intro h1 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(3rem, 6vw, 5.4rem);
		font-weight: 400;
		letter-spacing: 0;
		line-height: 0.98;
	}
	.intro-copy {
		max-width: 470px;
		margin: 1.5rem 0 0;
		color: #56615d;
		font-size: 1.05rem;
	}
	.growth {
		border-top: 1px solid #d7ddd8;
		padding-top: 2rem;
	}
	.section-heading,
	.result-row {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
	}
	.section-heading h2,
	.calculator h2 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 2rem;
		font-weight: 400;
		letter-spacing: 0;
	}
	.assumption,
	.result-note {
		margin: 0 0 0.2rem;
		color: #68736e;
		font-size: 0.85rem;
	}
	.result-row {
		align-items: center;
		margin: 2.25rem 0 0.5rem;
	}
	.result-row > div {
		display: grid;
		gap: 0.2rem;
	}
	.result-label {
		color: #68736e;
		font-size: 0.83rem;
	}
	.result-row strong {
		color: #174e40;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 2.5rem;
		font-weight: 400;
		line-height: 1.1;
	}
	.chart-wrap {
		width: 100%;
		margin: 0.75rem 0 2.5rem;
	}
	.chart-wrap svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}
	:global(.chart-grid line) {
		stroke: #dfe5df;
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}
	:global(.chart-labels) {
		fill: #78817c;
		font-family: var(--font-atkinson);
		font-size: 12px;
	}
	:global(.chart-area) {
		fill: #d9eee4;
		opacity: 0.72;
	}
	:global(.chart-line) {
		fill: none;
		stroke: #26735e;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 3;
		vector-effect: non-scaling-stroke;
	}
	.calculator {
		display: grid;
		grid-template-columns: minmax(220px, 0.8fr) 1.5fr;
		gap: 3rem;
		border-top: 1px solid #d7ddd8;
		padding: 2.5rem 0;
	}
	.calculator-copy > p:last-child {
		max-width: 250px;
		margin: 0.8rem 0 0;
		color: #68736e;
		font-size: 0.9rem;
	}
	.calculator form {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: end;
		gap: 1rem;
	}
	.calculator label {
		display: grid;
		gap: 0.45rem;
		color: #46514c;
		font-size: 0.8rem;
		font-weight: 700;
	}
	.input-wrap {
		display: flex;
		align-items: center;
		min-width: 0;
		min-height: 48px;
		gap: 0.55rem;
		border: 1px solid #cbd3cd;
		border-radius: 3px;
		background: #fff;
		padding: 0 0.75rem;
		color: #68736e;
	}
	.input-wrap:focus-within {
		border-color: #26735e;
		box-shadow: 0 0 0 2px #d9eee4;
	}
	.input-wrap input {
		width: 100%;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: #202a25;
		font: inherit;
		font-size: 1rem;
	}
	.input-wrap input::-webkit-inner-spin-button,
	.input-wrap input::-webkit-outer-spin-button {
		margin: 0;
	}
	.unit {
		font-size: 0.78rem;
		font-weight: 400;
	}
	.calculator button {
		grid-column: 1 / -1;
		justify-self: start;
		min-height: 48px;
		border: 0;
		border-radius: 3px;
		background: #174e40;
		padding: 0.75rem 1.1rem;
		color: #fff;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 700;
		cursor: pointer;
	}
	.calculator button:hover {
		background: #26735e;
	}
	.calculator button:focus-visible {
		outline: 3px solid #95c7ae;
		outline-offset: 3px;
	}
	.form-error {
		grid-column: 1 / -1;
		margin: 0;
		color: #a33d2e;
		font-size: 0.85rem;
	}
	.disclaimer {
		border-top: 1px solid #d7ddd8;
		margin: 0;
		padding-top: 1rem;
		color: #68736e;
		font-size: 0.76rem;
	}
	@media (max-width: 760px) {
		main {
			padding: 2rem 1.25rem;
		}
		.intro {
			padding: 1.5rem 0 3rem;
		}
		.section-heading,
		.result-row {
			align-items: start;
			flex-direction: column;
		}
		.section-heading h2,
		.calculator h2 {
			font-size: 1.7rem;
		}
		.assumption {
			margin-top: 0.25rem;
		}
		.result-row {
			gap: 0.5rem;
			margin-top: 1.5rem;
		}
		.result-row strong {
			font-size: 2rem;
		}
		.chart-labels {
			font-size: 10px;
		}
		.calculator {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
		.calculator form {
			grid-template-columns: 1fr;
		}
		.calculator button {
			grid-column: auto;
			width: 100%;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.intro,
		.growth,
		.calculator {
			animation: appear 500ms ease-out both;
		}
		.growth {
			animation-delay: 80ms;
		}
		.calculator {
			animation-delay: 140ms;
		}
	}
	@keyframes appear {
		from { opacity: 0; transform: translateY(8px); }
		to { opacity: 1; transform: translateY(0); }
	}
</style>
